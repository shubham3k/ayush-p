# Copy to .env.local for local development; set the same names in Vercel → Settings → Environment Variables.

# Required: API key from https://resend.com (sign up with the same email that should receive enquiries).
RESEND_API_KEY=

# Optional: where enquiries go (defaults to the email in lib/config.ts).
CONTACT_TO_EMAIL=

# Optional: sender. The default (onboarding@resend.dev) only delivers to the email your Resend
# account was created with. To send to any address, verify your own domain in Resend and use e.g.
# "Portfolio <enquiries@yourdomain.com>".
CONTACT_FROM_EMAIL=
